# Visual Studio user-specific files
.vs/

# Compiled object files
*.slo
*.lo
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Compiled dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Project files generated by Unreal Engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Editor-generated configuration and logs
Saved/*

# Compiled source files
Intermediate/*
Plugins/**/Intermediate/*

# Derived data cache
DerivedDataCache/*
